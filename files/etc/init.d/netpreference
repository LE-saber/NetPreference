#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
 procd_open_instance daemon
 procd_set_param command /usr/sbin/netpreference serve
 procd_set_param respawn 3600 5 5
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_set_param term_timeout 15
 procd_close_instance

 procd_open_instance guard
 procd_set_param command /usr/sbin/netpreference guard
 procd_set_param respawn 3600 5 5
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
}

reload_service() {
 /usr/sbin/netpreference reload
}

stop_service() {
 # Preserve the desired boot setting; Restore explicitly disables it.
 /usr/sbin/netpreference deactivate
}

service_triggers() {
 procd_add_reload_trigger netpreference
}
