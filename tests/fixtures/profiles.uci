package netpreference
config global 'main'
 option enabled '1'
 list interface 'br-lan'
 option upstream '127.0.0.1:53'
config device 'workstation'
 option mac '02:00:00:00:00:01'
 option mode 'ipv4'
 option wait_ms '75'
 option delay_ms '40'
 option profile 'work'
config profile 'work'
 option name 'Work mode'
 option description 'Selected domains prefer IPv6; everything else keeps the device default.'
config profile 'travel'
 option name 'Travel mode'
config domain_set 'media'
 option name 'Media domains'
 list domain '*.MEDIA.TEST.'
 list domain 'video.test'
config policy 'media_v6'
 option profile 'work'
 option domain_set 'media'
 option mode 'ipv6'
 option wait_ms '250'
 option delay_ms '150'
config policy 'zero_probe'
 option profile 'work'
 option domain 'zero.test'
 option mode 'custom'
 option prefer 'ipv4'
 option wait_ms '0'
 option delay_ms '0'
 option probe '0'
config policy 'inherit_all'
 option profile 'work'
 option domain 'inherit.test'
 option wait_ms ''
 option delay_ms ''
 option probe ''
config policy 'travel_dual'
 option profile 'travel'
 option domain '*'
 option mode 'dual'
config rule 'legacy_block'
 option device '*'
 option domain 'blocked.test'
 option action 'nxdomain'
config rule 'work_no6'
 option profile 'work'
 option domain 'restricted.test'
 option qtype 'AAAA'
 option action 'nodata'
